# The active civic UI uses the deterministic synthetic SQLite adapter.
# Never put officer credentials in VITE_*.
# Create a private officer key locally, set it in the API shell and enter it in
# the Demo administrator access form. Do not commit generated values.
NAGARSEVA_OFFICER_KEY=
NAGARSEVA_MODE=pilot-prototype
# Paths are relative to the API working directory (nagarseva).
URBANSAARTHI_DB_PATH=model/data/local/urbansaarthi.sqlite3
# Archived source-reader APIs are preserved but disconnected from the active UI.
# Leave this unset for the synthetic prototype; controlled file imports do not use it.
# URBANSAARTHI_DATA_DIR=../data/processed
# Optional consented inspection and issue images, up to 2 MiB per file. Set to
# sqlite to enable private image storage; leave blank for reference-only evidence.
URBANSAARTHI_EVIDENCE_STORAGE=
NAGARSEVA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional API proxy target for the existing Vite dev/preview server.
# NAGARSEVA_API_TARGET=http://127.0.0.1:8000
# GeoJSON/CSV onboarding supports isolated, explicitly confirmed server-side imports.
# No external government API or production identity provider is configured here.
