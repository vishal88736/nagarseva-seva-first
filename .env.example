# Public data is read without credentials. Never put officer credentials in VITE_*.
# Create a private officer key locally, set it in the API shell and enter it in
# the Officer access form. Do not commit generated values.
NAGARSEVA_OFFICER_KEY=
NAGARSEVA_MODE=pilot-prototype
# Paths are relative to the API working directory (nagarseva).
URBANSAARTHI_DB_PATH=model/data/local/urbansaarthi.sqlite3
URBANSAARTHI_DATA_DIR=../data/processed
# Optional consented inspection uploads, up to 2 MiB per file. Leave blank to
# retain references to evidence in an approved external store instead.
URBANSAARTHI_EVIDENCE_STORAGE=
NAGARSEVA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
